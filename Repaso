public class Libro {

    private int codigo;
    private String titulo;
    private String autor;
    private int anioPublicacion;
    private double precio;

    public Libro(int codigo, String titulo, String autor,
                 int anioPublicacion, double precio) {

        this.codigo = codigo;
        this.titulo = titulo;
        this.autor = autor;
        this.anioPublicacion = anioPublicacion;
        this.precio = precio;
    }

    public int getCodigo() {
        return codigo;
    }

    public void setCodigo(int codigo) {
        this.codigo = codigo;
    }

    public String getTitulo() {
        return titulo;
    }

    public void setTitulo(String titulo) {
        this.titulo = titulo;
    }

    public String getAutor() {
        return autor;
    }

    public void setAutor(String autor) {
        this.autor = autor;
    }

    public int getAnioPublicacion() {
        return anioPublicacion;
    }

    public void setAnioPublicacion(int anioPublicacion) {
        this.anioPublicacion = anioPublicacion;
    }

    public double getPrecio() {
        return precio;
    }

    public void setPrecio(double precio) {
        this.precio = precio;
    }

    @Override
    public String toString() {
        return codigo + " | " + titulo +
                " | " + autor +
                " | Año: " + anioPublicacion +
                " | $" + precio;
    }
}
import java.util.ArrayList;

public class GestionLibros {

    private ArrayList<Libro> libros;

    public GestionLibros() {

        libros = new ArrayList<>();
        precargarLibros();
    }

    private void precargarLibros() {

        libros.add(new Libro(101, "Clean Code", "Robert Martin", 2008, 45.50));
        libros.add(new Libro(102, "Java Cómo Programar", "Deitel", 2014, 60.00));
        libros.add(new Libro(103, "Algoritmos", "Cormen", 2009, 75.20));
        libros.add(new Libro(104, "Thinking in Java", "Bruce Eckel", 2006, 55.80));
        libros.add(new Libro(105, "Patrones de Diseño", "GoF", 1995, 70.00));
    }

    public ArrayList<Libro> getLibros() {
        return libros;
    }

    // =========================================
    // AGREGAR LIBRO
    // =========================================
    public boolean agregarLibro(Libro libro) {

        for (Libro l : libros) {

            if (l.getCodigo() == libro.getCodigo()) {
                return false;
            }
        }

        libros.add(libro);
        return true;
    }

    // =========================================
    // BUSQUEDA SECUENCIAL
    // =========================================
    public Libro buscarPorTituloSecuencial(String titulo) {

        for (Libro l : libros) {

            if (l.getTitulo().equalsIgnoreCase(titulo)) {
                return l;
            }
        }

        return null;
    }

    // =========================================
    // ORDENAMIENTO BURBUJA
    // =========================================
    public ArrayList<Libro> ordenarPorPrecioDescendente() {

        for (int i = 0; i < libros.size() - 1; i++) {

            for (int j = 0; j < libros.size() - 1 - i; j++) {

                if (libros.get(j).getPrecio() <
                        libros.get(j + 1).getPrecio()) {

                    Libro aux = libros.get(j);
                    libros.set(j, libros.get(j + 1));
                    libros.set(j + 1, aux);
                }
            }
        }

        return libros;
    }

    // =========================================
    // ORDENAR POR CODIGO
    // =========================================
    private void ordenarPorCodigo() {

        for (int i = 0; i < libros.size() - 1; i++) {

            for (int j = 0; j < libros.size() - 1 - i; j++) {

                if (libros.get(j).getCodigo() >
                        libros.get(j + 1).getCodigo()) {

                    Libro aux = libros.get(j);
                    libros.set(j, libros.get(j + 1));
                    libros.set(j + 1, aux);
                }
            }
        }
    }

    // =========================================
    // BUSQUEDA BINARIA
    // =========================================
    public Libro buscarPorCodigoBinario(int codigo) {

        ordenarPorCodigo();

        int inicio = 0;
        int fin = libros.size() - 1;

        while (inicio <= fin) {

            int medio = (inicio + fin) / 2;

            if (libros.get(medio).getCodigo() == codigo) {
                return libros.get(medio);
            }

            if (codigo < libros.get(medio).getCodigo()) {
                fin = medio - 1;
            } else {
                inicio = medio + 1;
            }
        }

        return null;
    }

    // =========================================
    // RECURSIVIDAD CONTAR
    // =========================================
    public int contarRecursivo(int indice) {

        if (indice == libros.size()) {
            return 0;
        }

        return 1 + contarRecursivo(indice + 1);
    }

    // =========================================
    // SUMA RECURSIVA
    // =========================================
    public double sumaPreciosRecursiva(int indice) {

        if (indice == libros.size()) {
            return 0;
        }

        return libros.get(indice).getPrecio()
                + sumaPreciosRecursiva(indice + 1);
    }

    // =========================================
    // PROMEDIO RECURSIVO
    // =========================================
    public double precioPromedioRecursivo() {

        int total = contarRecursivo(0);

        if (total == 0) {
            return 0;
        }

        return sumaPreciosRecursiva(0) / total;
    }
}

